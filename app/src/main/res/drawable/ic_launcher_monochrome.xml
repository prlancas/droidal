<!--
    Themed-icon silhouette for Android 13+ (`<monochrome>` slot of the
    adaptive icon). The system tints this drawable with a single themed
    colour, so we draw both eyes plus their pupils in one path with
    fill-type `evenOdd`: the pupils sit inside the eye discs, the even
    winding count makes them transparent, leaving cleanly cut-out pupils.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M37,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z M71,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z M37,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z M71,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />
</vector>
