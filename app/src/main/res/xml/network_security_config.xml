<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        The ROS bridge uses an unencrypted LAN WebSocket (ws://). Android
        treats that as cleartext traffic, so every concrete robot address
        needs to be permitted here. Supported ROS hosts include .104 and .165.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.104</domain>
        <domain includeSubdomains="true">192.168.1.165</domain>
        <domain includeSubdomains="true">192.168.1.130</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    
    <!-- Allow HTTP traffic to localhost for development -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
