<?xml version="1.0" encoding="utf-8"?>
<!--
    Droidal launcher foreground: two glowing robot eyes that mirror the
    in-app FaceCanvas (blue → white → gray radial gradient sclera with a
    black pupil and white highlight). Eye centres are positioned so that
    the dark outline rings stay within the 66×66 adaptive-icon safe zone
    (centred on 54,54 in the 108×108 viewport).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left eye: soft cyan glow halo -->
    <path android:pathData="M37,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="37"
                android:centerY="54"
                android:gradientRadius="22"
                android:startColor="#5529B6F6"
                android:endColor="#0029B6F6" />
        </aapt:attr>
    </path>

    <!-- Left eye: dark outline ring -->
    <path
        android:fillColor="#FF111111"
        android:pathData="M37,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />

    <!-- Left eye: sclera with blue → white → gray gradient -->
    <path android:pathData="M37,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="51"
                android:gradientRadius="20"
                android:startColor="#FF1565C0"
                android:centerColor="#FFFFFFFF"
                android:endColor="#FF6B6B6B" />
        </aapt:attr>
    </path>

    <!-- Left eye: pupil -->
    <path
        android:fillColor="#FF0A0A0A"
        android:pathData="M37,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z" />

    <!-- Left eye: specular highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,50 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />

    <!-- Right eye: soft cyan glow halo -->
    <path android:pathData="M71,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="71"
                android:centerY="54"
                android:gradientRadius="22"
                android:startColor="#5529B6F6"
                android:endColor="#0029B6F6" />
        </aapt:attr>
    </path>

    <!-- Right eye: dark outline ring -->
    <path
        android:fillColor="#FF111111"
        android:pathData="M71,54 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />

    <!-- Right eye: sclera with blue → white → gray gradient -->
    <path android:pathData="M71,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="69"
                android:centerY="51"
                android:gradientRadius="20"
                android:startColor="#FF1565C0"
                android:centerColor="#FFFFFFFF"
                android:endColor="#FF6B6B6B" />
        </aapt:attr>
    </path>

    <!-- Right eye: pupil -->
    <path
        android:fillColor="#FF0A0A0A"
        android:pathData="M71,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z" />

    <!-- Right eye: specular highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M68,50 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
</vector>
