<?xml version="1.0" encoding="utf-8"?>
<!--
    Sepia/tan radial-gradient that matches the in-app FaceCanvas background
    (canvas.drawARGB(255, 128, 108, 81) ≈ #806C51). The gradient gives the
    icon depth at any launcher mask shape (circle, squircle, square).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startColor="#FFB39A7B"
                android:endColor="#FF3E3327" />
        </aapt:attr>
    </path>
</vector>
